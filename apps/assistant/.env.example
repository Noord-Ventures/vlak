# Set this on the server only. Never use a NEXT_PUBLIC_ prefix for secrets.
OPENAI_API_KEY=
# Choose a Responses API model available to your project.
AI_REFERENCE_MODEL=gpt-6-astra
# Optional local directory. Persistent storage is required for a deployed app.
AI_REFERENCE_DATA_DIR=.data
# Deterministic protocol tests only. Leave unset for real model responses.
# AI_REFERENCE_MODE=fixture
# Required for Vercel deployment. Connect a dedicated private Blob store.
# AI_REFERENCE_STORAGE=blob
# BLOB_READ_WRITE_TOKEN=
# Stable server secret: generate 32 random bytes and encode as hex.
# AI_REFERENCE_APPROVAL_SECRET=
# Optional hosted daily model-run caps (positive integers).
# AI_REFERENCE_DAILY_REQUESTS=200
# AI_REFERENCE_SESSION_DAILY_REQUESTS=20
