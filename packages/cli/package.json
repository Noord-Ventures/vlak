{
  "name": "@noorddev/vlak-cli",
  "version": "0.4.0",
  "description": "The Vlak CLI — install the minimal design system into any project: npx @noorddev/vlak-cli init, npx @noorddev/vlak-cli add <component>.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Noord-Ventures/vlak.git",
    "directory": "packages/cli"
  },
  "homepage": "https://vlak.dev",
  "bugs": {
    "url": "https://github.com/Noord-Ventures/vlak/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "vlak": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @noorddev/vlak build:css && pnpm --filter @noorddev/vlak build:registry && tsup && node scripts/copy-fonts.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@noorddev/vlak": "workspace:*",
    "@types/node": "^26.4.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "cli",
    "design-system",
    "shadcn",
    "registry",
    "components"
    ,"react-component-library"
    ,"typescript"
    ,"accessible-components"
    ,"stylex"
  ],
  "author": "Renato Valdés Olmos"
}
