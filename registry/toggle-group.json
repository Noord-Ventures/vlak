{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "toggle-group",
  "type": "registry:component",
  "title": "Toggle group",
  "description": "Selects one option from joined toggles. The active option fills with ink.",
  "registryDependencies": [
    "https://vlak.dev/r/vlak-base.json",
    "https://vlak.dev/r/inter.json",
    "https://vlak.dev/r/toggle.json",
    "https://vlak.dev/r/vlak-lib.json"
  ],
  "dependencies": [
    "@stylexjs/stylex"
  ],
  "devDependencies": [
    "@stylexjs/babel-plugin"
  ],
  "docs": "Vlak leaves are StyleX. Compile them with @stylexjs/babel-plugin (Vite: @stylexjs/unplugin, Next: @stylexjs/nextjs-plugin). If you would rather not run a compiler, import @noorddev/vlak-react instead: it ships precompiled with one stylesheet.",
  "files": [
    {
      "path": "vlak/toggle-group.tsx",
      "content": "export { ToggleGroup, type ToggleGroupProps } from \"./toggle\";\n",
      "type": "registry:component",
      "target": "components/vlak/toggle-group.tsx"
    },
    {
      "path": "vlak/styles/toggle.css",
      "content": "/* ── toggle: generated from packages/react/src/components/toggle.tsx ── */\n.rs-toggle{box-sizing:border-box;display:inline-flex;align-items:center;justify-content:center;gap:0.375rem;height:var(--hit);min-width:var(--hit);padding-block:0;padding-inline:0.625rem;font-size:0.8125rem;font-weight:500;letter-spacing:-0.01em;background-color:transparent;border-width:1px;border-style:solid;border-color:var(--control-border);border-radius:var(--radius-sm);color:var(--text-secondary);cursor:pointer;font-family:inherit;transition:var(--transition)}\n.rs-toggle:hover{background-color:var(--control-fill);border-color:var(--control-fill);color:var(--text)}\n.rs-toggle:focus-visible{outline-width:2px;outline-style:solid;outline-color:var(--text);outline-offset:2px}\n@media (max-width: 640px){.rs-toggle{height:var(--hit);min-height:var(--hit);min-width:var(--hit);padding-inline:0.875rem;font-size:var(--control-fs);border-radius:var(--radius-sm)}}\n@media (forced-colors: active){.rs-toggle{background-color:ButtonFace;border-color:ButtonText;color:ButtonText}}\n@media (prefers-reduced-motion: reduce){.rs-toggle{transition:none}}\n.rs-toggle-pressed{background-color:var(--text);border-color:var(--text);color:var(--bg);forced-color-adjust:none}\n@media (forced-colors: active){.rs-toggle-pressed{background-color:Highlight;border-color:Highlight;color:HighlightText}}\n.rs-toggle-group{display:inline-flex;align-items:stretch;box-sizing:border-box;min-height:calc(var(--hit) + 2 * 1px);border-width:1px;border-style:solid;border-color:var(--text);border-radius:var(--radius-sm);overflow:hidden}\n@media (max-width: 640px){.rs-toggle-group{display:flex;width:100%;border-radius:var(--radius-sm)}}\n@media (forced-colors: active){.rs-toggle-group{border-color:ButtonText}}\n.rs-toggle-grouped{height:auto;min-height:var(--hit);border-width:0;border-radius:0;margin:0;border-inline-start-width:0;border-inline-start-style:none;border-inline-start-color:transparent}\n.rs-toggle-grouped:focus-visible{outline-offset:-2px}\n.rs-toggle-grouped:not(:first-child){border-inline-start-width:1px;border-inline-start-style:solid;border-inline-start-color:var(--control-border)}\n@media (max-width: 640px){.rs-toggle-grouped{flex-grow:1}}\n.rs-toggle-grouped-on{position:relative;z-index:1}\n",
      "type": "registry:file",
      "target": "styles/vlak/toggle.css"
    }
  ],
  "meta": {
    "vlak": {
      "category": "actions",
      "classes": [
        "rs-toggle-group"
      ],
      "snippet": "<div class=\"rs-toggle-group\"><button class=\"rs-toggle\" aria-pressed=\"true\">Left</button><button class=\"rs-toggle\" aria-pressed=\"false\">Center</button><button class=\"rs-toggle\" aria-pressed=\"false\">Right</button></div>",
      "cssOnly": false,
      "registryDependencies": [
        "toggle",
        "vlak-lib"
      ],
      "aliases": [
        "Toggle group",
        "Segmented control",
        "Exclusive toggles"
      ],
      "example": "import { useState } from \"react\";\nimport { ToggleGroup } from \"@noorddev/vlak-react\";\n\nconst [align, setAlign] = useState(\"left\");\n\n<ToggleGroup\n  aria-label=\"Alignment\"\n  options={[\n    { value: \"left\", label: \"Left\" },\n    { value: \"center\", label: \"Center\" },\n    { value: \"right\", label: \"Right\" },\n  ]}\n  value={align}\n  onValueChange={setAlign}\n/>",
      "usage": {
        "use": [
          "One of two to five options that should all stay visible: alignment, view mode, period.",
          "Short labels of equal weight."
        ],
        "avoid": [
          "Many or long options; use Select.",
          "Multiple selection; use several Toggle buttons."
        ]
      },
      "keyboard": [
        {
          "keys": "Tab",
          "does": "Moves between the options"
        },
        {
          "keys": "Enter, Space",
          "does": "Selects the focused option"
        }
      ],
      "a11y": [
        "Renders role=\"group\" of native buttons with aria-pressed; pass aria-label to name the group.",
        "Controlled with value and onValueChange, or uncontrolled with defaultValue."
      ]
    }
  }
}
