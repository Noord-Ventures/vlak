{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter www build",
  "outputDirectory": "apps/www/out",
  "redirects": [
    {
      "source": "/interfaces/ai-tool",
      "destination": "/interfaces/line/",
      "permanent": true
    },
    {
      "source": "/interfaces/ai-tool/",
      "destination": "/interfaces/line/",
      "permanent": true
    },
    {
      "source": "/interfaces/dashboard",
      "destination": "/interfaces/press/",
      "permanent": true
    },
    {
      "source": "/interfaces/dashboard/",
      "destination": "/interfaces/press/",
      "permanent": true
    },
    {
      "source": "/interfaces/threads",
      "destination": "/interfaces/wall/",
      "permanent": true
    },
    {
      "source": "/interfaces/threads/",
      "destination": "/interfaces/wall/",
      "permanent": true
    },
    {
      "source": "/interfaces/fleet",
      "destination": "/interfaces/night/",
      "permanent": true
    },
    {
      "source": "/interfaces/fleet/",
      "destination": "/interfaces/night/",
      "permanent": true
    },
    {
      "source": "/interfaces/delivery",
      "destination": "/interfaces/evening/",
      "permanent": true
    },
    {
      "source": "/interfaces/delivery/",
      "destination": "/interfaces/evening/",
      "permanent": true
    },
    {
      "source": "/interfaces/slack",
      "destination": "/interfaces/room/",
      "permanent": true
    },
    {
      "source": "/interfaces/slack/",
      "destination": "/interfaces/room/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)(opengraph-image|twitter-image)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.sketchfab.com https://api.mapbox.com; style-src 'self' 'unsafe-inline' https://api.mapbox.com; img-src 'self' data: blob: https://upload.wikimedia.org https://is1-ssl.mzstatic.com; media-src 'self' blob: https://audio-ssl.itunes.apple.com; font-src 'self'; connect-src 'self' https://api.mapbox.com https://events.mapbox.com https://audio-ssl.itunes.apple.com; worker-src 'self' blob:; frame-src https://sketchfab.com https://*.sketchfab.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/(.*)\\.(woff2|webp|png|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/r/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/docs/(.*)\\.md",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(design|interfaces).md",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" }
      ]
    },
    {
      "source": "/llms(.*).txt",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
