{
  "name": "vlak-monorepo",
  "private": true,
  "version": "0.4.0",
  "description": "Vlak — a minimal, CSS-first design system. Tokens, components, CLI, registry, and docs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Noord-Ventures/vlak.git"
  },
  "homepage": "https://vlak.dev",
  "bugs": {
    "url": "https://github.com/Noord-Ventures/vlak/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "build:registry": "pnpm --filter @noorddev/vlak build:registry",
    "test": "pnpm -r --filter './packages/*' test",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "check:agents": "node scripts/check-agent-surfaces.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "size": "node scripts/size-budget.mjs",
    "smoke": "node scripts/smoke-tarball.mjs",
    "dev": "pnpm --filter www dev"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18",
    "@biomejs/biome": "^2.5.12",
    "publint": "^0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "baseline-browser-mapping": "2.11.20",
      "electron-to-chromium": "1.5.420",
      "jose": "6.2.10",
      "postcss": "8.5.27"
    }
  }
}
