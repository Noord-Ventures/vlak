{
  "name": "www",
  "version": "0.5.0",
  "private": true,
  "description": "vlak.dev \u2014 documentation and component gallery for the Vlak design system.",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/build-deps.mjs",
    "predev": "node scripts/copy-registry.mjs && node --experimental-strip-types ../../scripts/build-interface-starters.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs",
    "e2e": "node scripts/e2e.mjs && node scripts/workspaces-e2e.mjs"
  },
  "dependencies": {
    "@noorddev/vlak": "workspace:*",
    "@noorddev/vlak-react": "workspace:*",
    "@stylexjs/stylex": "^0.19.0",
    "next": "^15.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.184.0",
    "streamdown": "^2.6.0",
    "shiki": "^3.19.0",
    "@streamdown/math": "^1.0.2",
    "@streamdown/cjk": "^1.0.3",
    "mermaid": "^11.12.2",
    "@xyflow/react": "^12.11.6",
    "react-jsx-parser": "^2.4.1",
    "katex": "^0.16.27",
    "acorn": "^8.15.0",
    "acorn-jsx": "^5.3.2"
  },
  "devDependencies": {
    "@babel/plugin-syntax-jsx": "^7",
    "@babel/plugin-syntax-typescript": "^7",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/postcss-plugin": "^0.19.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.184.1",
    "axe-core": "^4",
    "babel-loader": "^10",
    "playwright": "1.56.1",
    "typescript": "^5.9.3"
  }
}
