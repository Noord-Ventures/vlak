{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/out",
      "!**/.next",
      "!**/public",
      "!registry",
      "!**/.build-components",
      "!packages/core/css",
      "!packages/core/tokens",
      "!packages/core/test/fixtures/vlak-0.5.0.css",
      "!packages/cli/src/starter.html",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "recommended": true,
        "noAutofocus": "off",
        "noLabelWithoutControl": "off",
        "noNoninteractiveTabindex": "off",
        "noStaticElementInteractions": "off",
        "noSvgWithoutTitle": "off",
        "useSemanticElements": "off",
        "useKeyWithClickEvents": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn"
      },
      "performance": {
        "noImgElement": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off",
        "noDescendingSpecificity": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noUnknownAtRules": "off"
      },
      "complexity": {
        "noImportantStyles": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/react/src/components/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noAriaHiddenOnFocusable": "warn",
            "useFocusableInteractive": "warn",
            "useAriaPropsSupportedByRole": "warn"
          }
        }
      }
    }
  ]
}
