  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "design-system",
    "agents",
    "components"
    ,"coding-agents"
    ,"react-component-library"
    ,"accessible-components"
  ],
  "author": "Renato Valdés Olmos"
