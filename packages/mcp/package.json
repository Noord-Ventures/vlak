{
  "name": "@noorddev/vlak-mcp",
  "version": "0.4.0",
  "description": "MCP server for the Vlak design system: components, props, docs, tokens, and install commands for coding agents. Works offline.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Noord-Ventures/vlak.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://vlak.dev",
  "bugs": {
    "url": "https://github.com/Noord-Ventures/vlak/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "vlak-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-data.mjs",
